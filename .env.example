# Copy to `.env` and adjust. Every value below is also the built-in default,
# so the app boots on a fresh clone with no `.env` at all.
#
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS / Linux)
#
# NOTE: `tests/test_foundation.py::test_env_example_stays_in_sync_with_settings`
# fails if a key documented here drifts from `app/core/config.py`.

# ── Environment ─────────────────────────────────────────
# development | testing | staging | production
# Only `development` auto-creates tables at startup; other environments are
# expected to run `alembic upgrade head` (Milestone 1B).
APP_ENV=development

# ── Database ────────────────────────────────────────────
# Local dev default: a file-backed SQLite database. No Docker, no server, no
# setup - and small enough to sit comfortably on an 8 GB RAM Windows machine.
#
# Production swap (same code, same models - just change this line):
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=sqlite:///./dropshipping_dev.db

# Echo every SQL statement to stdout. Useful while debugging, noisy otherwise.
# SQL_ECHO=false

# ── AI provider ─────────────────────────────────────────
# mock (default: no key, no network, no spend - used by tests)
# openai_compatible (real AI backend through any OpenAI-compatible API)
# anthropic | openai | gemini are reserved: valid to declare, but
# get_ai_provider() raises until that backend is implemented.
AI_PROVIDER=mock

# Real-provider settings (only read when AI_PROVIDER=openai_compatible).
# Get a key from your chosen service and paste it here - never commit .env.
AI_API_KEY=
# Defaults below target Groq's free plan (free key at console.groq.com,
# no card required). Gemini's free tier also works through its
# OpenAI-compatible endpoint: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# with a Gemini model id (check current free-tier models in AI Studio).
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=30

# ── Live web research (supplier / competitor page extraction) ─────────────
# Agent 1 can fetch real supplier and competitor product pages and read the
# price from their structured data (JSON-LD Product/Offer or og:price:amount).
# No headless browser: one HTTP GET plus stdlib parsing.
#
# Nothing is fetched unless a request supplies supplier_urls / competitor_urls.
# SSRF guard: http/https only, and loopback, link-local (169.254.x), private and
# reserved addresses are refused before any request is built.
WEB_RESEARCH_TIMEOUT_SECONDS=10

# Candidate-URL discovery. `none` is the safe default: no search request is
# ever made, and the agent falls back to the offline discovery adapter instead
# of inventing URLs.
#   none        never search (default)
#   duckduckgo  keyless public HTML endpoint
#   custom      JSON API at WEB_SEARCH_ENDPOINT, authenticated with
#               WEB_SEARCH_API_KEY when set (never commit a real key)
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENDPOINT=

# ── Two-way approval model ──────────────────────────────
# How long a LEVEL_2_APPROVAL request stays open before it expires.
DEFAULT_APPROVAL_EXPIRY_MINUTES=60

# ── Running locally (single worker: one process, low memory) ──────────────
#   python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000
