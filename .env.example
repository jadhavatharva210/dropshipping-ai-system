# Copy to `.env` and adjust. Every value below is also the built-in default,
# so the app boots on a fresh clone with no `.env` at all.
#
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS / Linux)
#
# NOTE: `tests/test_foundation.py::test_env_example_stays_in_sync_with_settings`
# fails if a key documented here drifts from `app/core/config.py`.

# ── Environment ─────────────────────────────────────────
# development | testing | staging | production
# Only `development` auto-creates tables at startup; other environments are
# expected to run `alembic upgrade head` (Milestone 1B).
APP_ENV=development

# ── Database ────────────────────────────────────────────
# Local dev default: a file-backed SQLite database. No Docker, no server, no
# setup - and small enough to sit comfortably on an 8 GB RAM Windows machine.
#
# Production swap (same code, same models - just change this line):
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=sqlite:///./dropshipping_dev.db

# Echo every SQL statement to stdout. Useful while debugging, noisy otherwise.
# SQL_ECHO=false

# ── AI provider ─────────────────────────────────────────
# mock | anthropic | openai | gemini
# `mock` is deterministic, offline and free: no API key, no network, no spend.
AI_PROVIDER=mock

# ── Two-way approval model ──────────────────────────────
# How long a LEVEL_2_APPROVAL request stays open before it expires.
DEFAULT_APPROVAL_EXPIRY_MINUTES=60

# ── Running locally (single worker: one process, low memory) ──────────────
#   python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000
