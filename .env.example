# ── Environment ─────────────────────────────────────────
APP_ENV=development

# ── Database ────────────────────────────────────────────
# Local dev default: SQLite (no Docker, no setup).
# Production swap: postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=sqlite:///./dropshipping_dev.db

# ── AI provider ─────────────────────────────────────────
# mock | anthropic | openai | gemini (mock = no key, no network, no spend)
AI_PROVIDER=mock

# ── Approvals ───────────────────────────────────────────
DEFAULT_APPROVAL_EXPIRY_MINUTES=60
